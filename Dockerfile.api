FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json tsconfig.base.json ./
COPY packages/contracts packages/contracts
COPY apps/api apps/api
COPY apps/web/package.json apps/web/package.json
COPY apps/simulators/package.json apps/simulators/package.json
RUN npm ci
RUN npm run build -w @opsflow/contracts && npm run generate -w @opsflow/api && npm run build -w @opsflow/api
ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "-c", "npm run migrate -w @opsflow/api && npm run seed -w @opsflow/api && node apps/api/dist/main.js"]
